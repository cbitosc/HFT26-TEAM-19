# Inference (local, default). Loopback only.
VG_ADAPTER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Preferred: abliterated derivative. Control/fallback: qwen3-vl:4b-instruct. Low memory: ...:2b
VG_MODEL=huihui_ai/qwen3-vl-abliterated:4b-instruct
VG_NUM_CTX=8192
VG_KEEP_ALIVE=30m
VG_MAX_TOKENS=2048

# Intake limits
VG_MAX_UPLOAD_MB=25
VG_MAX_PIXELS=60000000
VG_ANALYSIS_LONG_SIDE=1280

# Server (loopback by default; LAN use needs HTTPS + token, see docs)
VG_HOST=127.0.0.1
VG_PORT=8000

# Optional cloud adapter: DISABLED by default. No images leave the machine unless you enable it.
VG_FEATHERLESS_ENABLED=0
FEATHERLESS_API_KEY=

# Where photos and the SQLite database are stored (default: <project>/data)
VG_DATA_DIR=
# Listening beyond this computer has no login. Leave 0 unless you know why.
VG_ALLOW_NON_LOOPBACK=0

# Re-read each chip from a high-resolution crop (adds roughly 5-15 s per chip). 0 turns it off.
VG_DETAIL_PASS=1

# Overview sampling. Defaults follow the Qwen3-VL Instruct guide (temperature 0.7, top_p 0.8, top_k 20),
# including presence penalty 1.5. On the sample photo 0 and 0.5 still looped; 1.5 did not. See scripts/sweep_smoke.py.
VG_TEMPERATURE=0.7
VG_TOP_P=0.8
VG_TOP_K=20
VG_PRESENCE_PENALTY=1.5
# Find small parts by also analysing overlapping sections of the photo: off, 2x2, 3x2. Costs one model call per tile.
VG_TILES=off
# Look-alike search for repeated small parts (resistors, capacitors). The "Find more like this" button always works.
# VG_REPEATS=1 also runs it automatically after each analysis. Off by default: seeded from the model's own loose boxes it adds little.
VG_REPEATS=0
VG_SIMILAR_THRESHOLD=0.75
# Photos with a long side under this many pixels are enlarged for the model (boxes still map back to the original).
VG_ANALYSIS_MIN_LONG_SIDE=1024
